{
  "name": "cline2dsh",
  "version": "0.2.0",
  "description": "Cline free models for DeepSeek Harness (DSH): native dsh-llm adapter streaming from api.cline.bot with the locally logged-in Cline account, free models only.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfapex/cline2dsh.git"
  },
  "homepage": "https://github.com/lfapex/cline2dsh#readme",
  "bugs": "https://github.com/lfapex/cline2dsh/issues",
  "author": "lfapex",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cline",
    "cline-bot",
    "free-models",
    "llm-adapter",
    "cordis",
    "pi-ai",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
